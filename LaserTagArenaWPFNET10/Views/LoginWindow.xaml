<Window x:Class="LaserTagArenaWPFNET10.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LASERTAG ARENA // ДОСТУП К СИСТЕМЕ" 
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Определяем ресурсы, если они не определены глобально -->
        <SolidColorBrush x:Key="BgDark" Color="#0A0A0F"/>
        <SolidColorBrush x:Key="BgPanel" Color="#111118"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FFAA"/>
        <SolidColorBrush x:Key="AccentPink" Color="#FF3366"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666677"/>
    </Window.Resources>

    <Border Background="#0A0A0F" 
            CornerRadius="8"
            BorderBrush="#00FFAA"
            BorderThickness="2">

        <Border.Effect>
            <DropShadowEffect Color="#00FFAA" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <Border Grid.Row="0" 
                    Background="#111118" 
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="// LASERTAG ARENA // ВХОД В СИСТЕМУ" 
                               Foreground="#00FFAA" 
                               FontFamily="Consolas"
                               FontSize="11"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <Button Content="✕" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Width="30" Height="20"
                            Background="Transparent"
                            Foreground="#FF3366"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1" Margin="30">
                <StackPanel VerticalAlignment="Center">

                    <!-- Заголовок -->
                    <TextBlock Text="LASERTAG ARENA" 
                               FontFamily="Consolas"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#00FFAA"
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,5"/>

                    <TextBlock Text="> Заряжайся игрой! _" 
                               FontFamily="Consolas"
                               FontSize="14" 
                               Foreground="#FF3366"
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>

                    <!-- Логин -->
                    <Border Background="#151520" 
                            BorderBrush="#00FFAA" 
                            BorderThickness="1" 
                            CornerRadius="3"
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="[ ЛОГИН ]" 
                                       FontFamily="Consolas"
                                       Foreground="#00FFAA" 
                                       FontSize="12"
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"/>

                            <TextBox x:Name="txtLogin" 
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#00FFAA"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     CaretBrush="#00FFAA"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="5"/>
                        </Grid>
                    </Border>

                    <!-- Пароль -->
                    <Border Background="#151520" 
                            BorderBrush="#00FFAA" 
                            BorderThickness="1" 
                            CornerRadius="3"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="[ ПАРОЛЬ ]" 
                                       FontFamily="Consolas"
                                       Foreground="#00FFAA" 
                                       FontSize="12"
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"/>

                            <PasswordBox x:Name="txtPassword" 
                                         Grid.Column="1"
                                         Background="Transparent"
                                         Foreground="#00FFAA"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         CaretBrush="#00FFAA"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Margin="5"/>
                        </Grid>
                    </Border>

                    <!-- КНОПКА ВХОДА -->
                    <Button x:Name="btnLogin" 
                            Height="45" 
                            Margin="0,15,0,10"
                            Cursor="Hand"
                            Click="BtnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" 
                                        Background="#00FFAA" 
                                        CornerRadius="4"
                                        BorderThickness="0">

                                    <Border.Effect>
                                        <DropShadowEffect Color="#00FFAA" 
                                                          BlurRadius="10" 
                                                          ShadowDepth="0" 
                                                          Opacity="0.8"/>
                                    </Border.Effect>

                                    <TextBlock Text="[ ВОЙТИ В СИСТЕМУ ]" 
                                               FontFamily="Consolas"
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Foreground="#0A0A0F"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" 
                                                Property="Background" 
                                                Value="#00FFCC"/>
                                        <Setter TargetName="border" 
                                                Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00FFAA" 
                                                                  BlurRadius="20" 
                                                                  ShadowDepth="0" 
                                                                  Opacity="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" 
                                                Property="Background" 
                                                Value="#009966"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Статус -->
                    <TextBlock Text="> ДОСТУП: МЕНЕДЖЕР / АДМИНИСТРАТОР" 
                               FontFamily="Consolas"
                               FontSize="10" 
                               Foreground="#666677"
                               HorizontalAlignment="Center" 
                               Margin="0,5,0,0"/>

                    <TextBlock x:Name="txtStatus" 
                               FontFamily="Consolas"
                               FontSize="10" 
                               Foreground="#FF3366"
                               HorizontalAlignment="Center" 
                               Margin="0,5,0,0"/>

                    <Button Content="[ РЕГИСТРАЦИЯ ]" Height="30" Margin="0,12,0,0"
                            Background="Transparent" Foreground="#666677" BorderBrush="#666677"
                            BorderThickness="1" FontFamily="Consolas" FontSize="10" Cursor="Hand"
                            Click="BtnRegister_Click"/>

                </StackPanel>
            </Grid>

            <!-- Декоративные уголки -->
            <Line X1="0" Y1="0" X2="30" Y2="0" Stroke="#00FFAA" StrokeThickness="2" 
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,35,0,0"/>
            <Line X1="0" Y1="0" X2="0" Y2="30" Stroke="#00FFAA" StrokeThickness="2" 
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,35,0,0"/>

            <Line X1="0" Y1="0" X2="30" Y2="0" Stroke="#00FFAA" StrokeThickness="2" 
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>
            <Line X1="0" Y1="0" X2="0" Y2="30" Stroke="#00FFAA" StrokeThickness="2" 
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>

        </Grid>
    </Border>
</Window>