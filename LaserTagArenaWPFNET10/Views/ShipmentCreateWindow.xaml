<Window x:Class="LaserTagArenaWPFNET10.Views.ShipmentCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание поставки" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0A0A0F" CornerRadius="8"
            BorderBrush="#00FFAA" BorderThickness="2">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="[ СОЗДАНИЕ ПОСТАВКИ ]" Foreground="#00FFAA" 
                       FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Поставщик" Foreground="#666677" FontFamily="Consolas" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbSupplier" Background="#151520" Foreground="#00FFAA" 
                              FontFamily="Consolas" FontSize="12" BorderBrush="#00FFAA" 
                              BorderThickness="1" Padding="8" Margin="0,0,0,12"
                              DisplayMemberPath="Name"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Товар" Foreground="#666677" FontFamily="Consolas" Margin="0,0,0,3"/>
                            <ComboBox x:Name="cmbEquipment" Background="#151520" Foreground="#00FFAA" 
                                      FontFamily="Consolas" FontSize="12" BorderBrush="#00FFAA" 
                                      BorderThickness="1" Padding="8" DisplayMemberPath="Name"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Количество" Foreground="#666677" FontFamily="Consolas" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtQuantity" Background="#151520" Foreground="#00FFAA" 
                                     FontFamily="Consolas" FontSize="12" BorderBrush="#00FFAA" 
                                     BorderThickness="1" Padding="8" CaretBrush="#00FFAA"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="[ + ДОБАВИТЬ ТОВАР ]" Width="150" Height="30"
                            Background="Transparent" Foreground="#00FFAA" BorderBrush="#00FFAA"
BorderThickness="1" FontFamily="Consolas" FontSize="12" Cursor="Hand" Click="BtnAddItem_Click"/>

                    <DataGrid x:Name="dgItems" Margin="0,12,0,0" AutoGenerateColumns="False"
                              Background="#0A0A0F" Foreground="#00FFAA" FontFamily="Consolas" FontSize="11"
                              BorderBrush="#333344" BorderThickness="1" RowBackground="#0A0A0F"
                              AlternatingRowBackground="#111118" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              MaxHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="[ ТОВАР ]" Binding="{Binding EquipmentName}" Width="*"/>
                            <DataGridTextColumn Header="[ КОЛ-ВО ]" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="[ ЦЕНА ]" Binding="{Binding PricePerUnit}" Width="100"/>
                            <DataGridTemplateColumn Header="[ ДЕЙСТВИЯ ]" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Foreground="#FF3366" Background="Transparent"
                                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                                Click="BtnRemoveItem_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="[ СОЗДАТЬ ]" Width="120" Height="35"
                        Background="#00FFAA" Foreground="#0A0A0F"
                        FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                        Click="BtnCreate_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#00FFAA" CornerRadius="4" Padding="15,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#00FFCC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="[ ОТМЕНА ]" Width="100" Height="35" Margin="10,0,0,0"
                        Background="Transparent" Foreground="#666677" BorderBrush="#666677"
                        BorderThickness="1" FontFamily="Consolas" FontSize="13"
                        Click="BtnCancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" 
                                    BorderBrush="#666677" BorderThickness="1" CornerRadius="4" Padding="15,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF3366"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>