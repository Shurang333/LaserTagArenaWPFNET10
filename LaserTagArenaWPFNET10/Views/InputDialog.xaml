<Window x:Class="LaserTagArenaWPFNET10.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод" Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0A0A0F" CornerRadius="8"
            BorderBrush="#00FFAA" BorderThickness="2">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblPrompt" Text="Введите значение:" 
                       Foreground="#00FFAA" FontFamily="Consolas" FontSize="14"
                       Margin="0,0,0,15"/>

            <TextBox x:Name="txtInput" Grid.Row="1" 
                     Background="#151520" Foreground="#00FFAA" 
                     FontFamily="Consolas" FontSize="14"
                     BorderBrush="#00FFAA" BorderThickness="1"
                     Padding="10" CaretBrush="#00FFAA"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="[ ОК ]" Width="80" Height="30"
                        Background="#00FFAA" Foreground="#0A0A0F"
                        FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                        Click="BtnOk_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#00FFAA" CornerRadius="4" Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#00FFCC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="[ ОТМЕНА ]" Width="80" Height="30" Margin="10,0,0,0"
                        Background="Transparent" Foreground="#666677" BorderBrush="#666677"
                        BorderThickness="1" FontFamily="Consolas" FontSize="12"
                        Click="BtnCancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" 
                                    BorderBrush="#666677" BorderThickness="1" CornerRadius="4" Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00FFAA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>